<Window x:Class="PersonalRecorder.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PersonalRecorder"
 Title="Personal Recorder" Icon="Assets/PersonalRecorder.ico" Width="340" SizeToContent="Height" ResizeMode="CanMinimize"
 Background="#101724" Foreground="#EDF2FA" FontFamily="Segoe UI" FontSize="12"
 WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Window.CommandBindings>
  <CommandBinding Command="{x:Static local:MainWindow.OpenFolderCommand}" Executed="OpenFolder_Executed"/>
  <CommandBinding Command="{x:Static local:MainWindow.OpenSettingsCommand}" Executed="OpenSettings_Executed"/>
 </Window.CommandBindings>
 <Window.InputBindings>
  <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenFolderCommand}"/>
  <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static local:MainWindow.OpenSettingsCommand}"/>
 </Window.InputBindings>
 <Window.Resources>
  <Style x:Key="ShortcutLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#A9B8CF"/><Setter Property="FontSize" Value="10"/>
   <Setter Property="TextAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="Margin" Value="0,0,6,6"/>
   <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="Background" Value="#E3EAF5"/><Setter Property="Foreground" Value="#101724"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <StackPanel Margin="10">
  <DockPanel Margin="0,0,0,6">
   <Image Source="Assets/Logo.png" Width="18" Height="18" DockPanel.Dock="Left" Margin="0,0,8,0" ToolTip="Personal Recorder" RenderOptions.BitmapScalingMode="HighQuality"/>
   <TextBlock x:Name="TimerText" DockPanel.Dock="Right" Text="00:00:00" FontFamily="Consolas" FontSize="14"/>
   <TextBlock x:Name="StatusText" Text="Ready to record" Foreground="#6CE2C4" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <TextBlock x:Name="DetailText" Text="Choose an application in Settings." Foreground="#A9B8CF" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,8" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  <UniformGrid Columns="3">
   <StackPanel>
   <TextBlock x:Name="StartShortcutText" Style="{StaticResource ShortcutLabel}"/>
   <Button x:Name="StartButton" Content="● Start" Background="#6CE2C4" Click="Start_Click" AutomationProperties.Name="Start recording"/>
   </StackPanel>
   <StackPanel>
   <TextBlock x:Name="PauseShortcutText" Style="{StaticResource ShortcutLabel}"/>
   <Button x:Name="PauseButton" Content="Ⅱ Pause" Click="Pause_Click" IsEnabled="False" AutomationProperties.Name="Pause or resume recording"/>
   </StackPanel>
   <StackPanel>
   <TextBlock x:Name="StopShortcutText" Style="{StaticResource ShortcutLabel}"/>
   <Button x:Name="StopButton" Content="■ Stop" Click="Stop_Click" IsEnabled="False" AutomationProperties.Name="Stop and save recording"/>
   </StackPanel>
  </UniformGrid>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
   <Button x:Name="FolderButton" Click="OpenFolder_Click" Width="28" Height="25" Padding="5" Background="Transparent"
           ToolTip="Open recording folder" AutomationProperties.Name="Open recording folder">
    <Viewbox Width="15" Height="15"><Path Fill="#A9B8CF" Data="M2,4 L9,4 L11,6 L22,6 L22,9 L6,9 L3,20 L2,20 Z M7,10 L24,10 L21,20 L4,20 Z"/></Viewbox>
   </Button>
   <Button x:Name="SettingsButton" Content="⚙" Click="Settings_Click" Width="28" Height="25" Padding="0" Background="Transparent" Foreground="#A9B8CF" FontSize="18" Margin="0"
           ToolTip="Settings" AutomationProperties.Name="Settings"/>
  </StackPanel>
  <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed" Margin="0,12,0,0">
   <TextBlock x:Name="RecoveryHintText" Text="Recording stopped. Review the details before restarting." TextWrapping="Wrap" Foreground="#FFBE96" Margin="0,0,0,8"/>
   <WrapPanel>
    <Button Content="Error details" Click="ErrorDetails_Click"/>
    <Button x:Name="RetrySoftwareButton" Content="Retry: software · 30 FPS" Click="RetrySoftware_Click"
            ToolTip="Starts a new file at the same output resolution using software encoding and 30 FPS. This saves those preferences."/>
   </WrapPanel>
  </StackPanel>
 </StackPanel>
</Window>
