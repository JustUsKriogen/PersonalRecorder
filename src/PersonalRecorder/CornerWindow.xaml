<Window x:Class="PersonalRecorder.CornerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Personal Recorder mini panel" Width="234" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
 Background="#101724" Foreground="#EDF2FA" FontFamily="Segoe UI" FontSize="12"
 Icon="Assets/PersonalRecorder.ico">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#24354A"/><Setter Property="Foreground" Value="#EDF2FA"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,0,5,0"/>
   <Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Border BorderBrush="#42615D" BorderThickness="1" Padding="9">
  <StackPanel>
   <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,7" Cursor="SizeAll" ToolTip="Drag to move; double-click to restore">
    <Image Source="Assets/Logo.png" Width="18" Height="18" Margin="0,0,6,0"/>
    <TextBlock x:Name="ClockText" DockPanel.Dock="Right" FontFamily="Consolas" VerticalAlignment="Center"/>
    <TextBlock x:Name="StateText" TextTrimming="CharacterEllipsis" Foreground="#6CE2C4" VerticalAlignment="Center"/>
   </DockPanel>
   <UniformGrid Columns="4">
    <Button x:Name="StartControl" Content="●" Click="Start_Click" AutomationProperties.Name="Start recording"/>
    <Button x:Name="PauseControl" Content="Ⅱ" Click="Pause_Click" AutomationProperties.Name="Pause or resume"/>
    <Button x:Name="StopControl" Content="■" Click="Stop_Click" AutomationProperties.Name="Stop recording"/>
    <Button Content="↗" Click="Restore_Click" Margin="0" ToolTip="Restore recorder" AutomationProperties.Name="Restore recorder"/>
   </UniformGrid>
  </StackPanel>
 </Border>
</Window>
