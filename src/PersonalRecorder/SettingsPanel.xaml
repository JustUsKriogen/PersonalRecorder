<UserControl x:Class="PersonalRecorder.SettingsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#101724" Foreground="#EDF2FA" FontFamily="Segoe UI" FontSize="14">
    <UserControl.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#E3EAF5"/><Setter Property="Foreground" Value="#101724"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF2FA"/><Setter Property="Margin" Value="0,6,24,6"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#A9B8CF"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1A2537"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    </UserControl.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
 <DockPanel Margin="0,0,0,16">
  <Image Source="Assets/Logo.png" Width="40" Height="40" Margin="0,0,12,0" DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
  <StackPanel><TextBlock Text="Personal Recorder" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Text="Recording settings" Foreground="#A9B8CF" FontSize="13"/></StackPanel>
 </DockPanel>
            <StackPanel x:Name="ConfigurationPanel">
                <Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Refresh" x:Name="RefreshButton" Margin="8,0,0,0"/>
                        <TextBlock Text="01  Choose an application" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ComboBox x:Name="ApplicationPicker" DisplayMemberPath="Label" AutomationProperties.Name="Application to record"/>
                    <TextBlock Text="For a match, select the game window after it opens. The launcher and game are separate windows. Keep the target restored; use borderless mode for games." Foreground="#A9B8CF" FontSize="12" Margin="0,10,0,18"/>
                    <TextBlock Text="Output resolution — use a display’s configured pixel dimensions" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="DisplayPicker" DisplayMemberPath="Label" AutomationProperties.Name="Display resolution"/>
                    <TextBlock Text="The selected window fills this canvas with its aspect ratio preserved. Smaller windows are upscaled; other desktop windows are excluded." Foreground="#A9B8CF" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="02  Recording preferences" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Text="Save recordings to" Style="{StaticResource Label}"/>
                    <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" x:Name="BrowseButton" Margin="10,0,0,0"/>
                        <TextBox x:Name="FolderBox" AutomationProperties.Name="Recording folder"/></DockPanel>
                    <WrapPanel Margin="0,14,0,0">
                        <TextBlock Text="Target frame rate" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="FpsPicker" Width="110" SelectedIndex="1" AutomationProperties.Name="Frame rate"><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox>
                        <CheckBox x:Name="HardwareBox" Content="Hardware encoding" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="SystemAudioBox" Content="System audio (all apps)"/>
                        <CheckBox x:Name="MicrophoneBox" Content="Microphone"/>
                        <CheckBox x:Name="CursorBox" Content="Include cursor"/>
                    </WrapPanel>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="03  Global shortcuts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Text="Click a shortcut box, press your desired keys, then click Save settings. You can use F1–F24 alone." Foreground="#A9B8CF" FontSize="12" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Start recording" Style="{StaticResource Label}"/><TextBox x:Name="StartHotkeyBox" IsReadOnly="True" AutomationProperties.Name="Start recording shortcut"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Pause / resume" Style="{StaticResource Label}"/><TextBox x:Name="PauseHotkeyBox" IsReadOnly="True" AutomationProperties.Name="Pause or resume shortcut"/></StackPanel>
                        <StackPanel><TextBlock Text="Stop and save" Style="{StaticResource Label}"/><TextBox x:Name="StopHotkeyBox" IsReadOnly="True" AutomationProperties.Name="Stop recording shortcut"/></StackPanel>
                    </UniformGrid>
                    <TextBlock x:Name="HotkeyHint" Foreground="#A9B8CF" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel></Border>
            </StackPanel>
 </StackPanel></ScrollViewer>
 <DockPanel Grid.Row="1" Margin="0,8,0,0">
 <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Save settings" Background="#6CE2C4" Margin="12,0,0,0"/>
 <TextBlock x:Name="EditingHint" Text="Shortcuts are suspended while settings are open. Close this window to discard unsaved changes." Foreground="#A9B8CF" VerticalAlignment="Center"/>
 </DockPanel></Grid></UserControl>
